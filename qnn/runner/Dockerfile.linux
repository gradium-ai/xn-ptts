# The runner on arm64 Linux with QNN's CPU backend: checks the loop end to end
# without a Snapdragon device. Ubuntu 20.04 matches the QAIRT aarch64-ubuntu-gcc9.4 libraries.
FROM --platform=linux/arm64 ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends g++ make cmake ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /work
